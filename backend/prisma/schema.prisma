// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. MASTER DB MODELS (Public Schema)
// ==========================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(255)
  slug               String             @unique @db.VarChar(100)
  schemaName         String             @unique @map("schema_name") @db.VarChar(100)
  governorate        String             @db.VarChar(100)
  district           String             @db.VarChar(100)
  addressDetails     String?            @map("address_details") @db.Text
  googleMapsUrl      String?            @map("google_maps_url") @db.Text
  latitude           Decimal?           @db.Decimal(10, 8)
  longitude          Decimal?           @db.Decimal(11, 8)
  phone              String             @db.VarChar(50)
  logoUrl            String?            @map("logo_url") @db.Text
  receiptHeader      String?            @map("receipt_header") @db.Text
  receiptFooter      String?            @map("receipt_footer") @db.Text
  licenseKey         String             @unique @map("license_key") @db.VarChar(255)
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionEndsAt DateTime           @map("subscription_ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  searchIndexes CentralSearchIndex[]

  @@map("tenants")
}

model Medicine {
  id                  String   @id @default(uuid()) @db.Uuid
  tradeName           String   @map("trade_name") @db.VarChar(255)
  scientificName      String   @map("scientific_name") @db.VarChar(255)
  dosageForm          String?  @map("dosage_form") @db.VarChar(100)
  strength            String?  @db.VarChar(100)
  manufacturer        String?  @db.VarChar(255)
  barcode             String?  @db.VarChar(100)
  defaultUnitsPerPack Int      @default(1) @map("default_units_per_pack")
  isVerified          Boolean  @default(true) @map("is_verified")
  createdAt           DateTime @default(now()) @map("created_at")

  searchIndexes CentralSearchIndex[]

  @@index([barcode])
  @@index([tradeName])
  @@index([scientificName])
  @@map("medicines")
}

model CentralSearchIndex {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  medicineId       String   @map("medicine_id") @db.Uuid
  pharmacyName     String   @map("pharmacy_name") @db.VarChar(255)
  governorate      String   @db.VarChar(100)
  district         String   @db.VarChar(100)
  addressDetails   String?  @map("address_details") @db.Text
  googleMapsUrl    String?  @map("google_maps_url") @db.Text
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  phone            String   @db.VarChar(50)
  tradeName        String   @map("trade_name") @db.VarChar(255)
  scientificName   String   @map("scientific_name") @db.VarChar(255)
  sellingPricePack Decimal  @map("selling_price_pack") @db.Decimal(12, 2)
  isAvailable      Boolean  @default(true) @map("is_available")
  lastSyncedAt     DateTime @default(now()) @map("last_synced_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([tenantId, medicineId])
  @@index([governorate, district])
  @@index([tradeName])
  @@index([scientificName])
  @@map("central_search_index")
}

// ==========================================
// 2. TENANT DB MODELS (Per Pharmacy Schema)
// ==========================================

enum UserRole {
  OWNER
  CASHIER
}

enum UnitType {
  PACK
  STRIP
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  sales   Sale[]
  returns Return[]

  @@map("users")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  medicineId       String   @map("medicine_id") @db.Uuid
  unitsPerPack     Int      @default(1) @map("units_per_pack")
  sellingPricePack Decimal  @map("selling_price_pack") @db.Decimal(12, 2)
  sellingPriceUnit Decimal  @map("selling_price_unit") @db.Decimal(12, 2)
  minAlertUnits    Int      @default(5) @map("min_alert_units")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  batches   InventoryBatch[]
  saleItems SaleItem[]
  returns   Return[]

  @@index([medicineId])
  @@map("inventory_items")
}

model InventoryBatch {
  id                    String   @id @default(uuid()) @db.Uuid
  inventoryItemId       String   @map("inventory_item_id") @db.Uuid
  batchNumber           String?  @map("batch_number") @db.VarChar(100)
  purchasePricePack     Decimal  @map("purchase_price_pack") @db.Decimal(12, 2)
  quantityUnitsRemaining Int     @map("quantity_units_remaining")
  expiryDate            DateTime @map("expiry_date") @db.Date
  createdAt             DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  @@index([expiryDate])
  @@map("inventory_batches")
}

model Sale {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceNumber  String   @unique @map("invoice_number") @db.VarChar(50)
  userId         String   @map("user_id") @db.Uuid
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  saleItems SaleItem[]
  returns   Return[]

  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  inventoryItemId  String   @map("inventory_item_id") @db.Uuid
  inventoryBatchId String?  @map("inventory_batch_id") @db.Uuid
  unitType         UnitType @map("unit_type")
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice       Decimal  @map("total_price") @db.Decimal(12, 2)

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])

  @@map("sale_items")
}

model Return {
  id              String   @id @default(uuid()) @db.Uuid
  saleId          String?  @map("sale_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  unitType        UnitType @map("unit_type")
  quantity        Int
  refundAmount    Decimal  @map("refund_amount") @db.Decimal(12, 2)
  reason          String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  sale          Sale?         @relation(fields: [saleId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@map("returns")
}
